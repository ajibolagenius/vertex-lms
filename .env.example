# Clerk — https://dashboard.clerk.com
# Publishable key is client-safe and is the only Clerk credential exposed to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key is server-only. Never prefix it with NEXT_PUBLIC_.
CLERK_SECRET_KEY=

# Hosted sign-in / sign-up routes (app/sign-in, app/sign-up) and where to land afterwards.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sanity — https://www.sanity.io/manage
# Project id and dataset are client-safe.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-05
# Read token is server-only: the dataset is private. Viewer permissions, nothing more.
# Never prefix it with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# PostHog — https://eu.posthog.com
# Project token is public by design (AGENTS §12) and is the only PostHog credential
# the browser holds. Any private PostHog API key stays server-only.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Used as ui_host only; ingestion goes through the /ingest proxy in next.config.ts.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Sanity Context MCP — the search agent's endpoint (AGENTS §5/§10).
# Server-only: it is called with SANITY_API_READ_TOKEN as a Bearer token, and the
# browser must never see it. The dataset only serves this once the Studio application
# is deployed (§12) — see studio/scripts/context/README.md.
# The trailing slug selects the sanity.agentContext document holding the filter and instructions.
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v2026-03-03/context/mcp/<projectId>/production/vertex-search

# OpenAI — https://platform.openai.com/api-keys
# Server-only. Never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional override for the search model. Defaults to gpt-5.
OPENAI_SEARCH_MODEL=
# Optional override for the ask-this-lesson model (app/api/lesson-qa). Defaults to gpt-5.
OPENAI_LESSON_MODEL=

# Sanity write token. Server-only (AGENTS §12) — used by app/api/progress only, to save
# learner progress. Editor permissions on the progress type is enough. Never prefix it
# with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=
