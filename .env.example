# Clerk — https://dashboard.clerk.com
# Publishable key is client-safe and is the only Clerk credential exposed to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key is server-only. Never prefix it with NEXT_PUBLIC_.
CLERK_SECRET_KEY=

# Hosted sign-in / sign-up routes (app/sign-in, app/sign-up) and where to land afterwards.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sanity — https://www.sanity.io/manage
# Project id and dataset are client-safe.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-05
# Read token is server-only: the dataset is private. Viewer permissions, nothing more.
# Never prefix it with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# PostHog — https://eu.posthog.com
# Project token is public by design (AGENTS §12) and is the only PostHog credential
# the browser holds. Any private PostHog API key stays server-only.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Used as ui_host only; ingestion goes through the /ingest proxy in next.config.ts.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
